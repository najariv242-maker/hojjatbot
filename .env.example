# توکن ربات دریافتی از BotFather@
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# آیدی عددی تلگرام شما (از ربات userinfobot@ دریافت کنید)
ADMIN_ID=123456789

# مسیر دیتابیس (اختیاری)
DB_PATH=consulting_bot.db

# پورت سرور سلامتی (رندر خودکار ست می‌کند یا پیش‌فرض 10000)
PORT=10000

# آدرس عمومی برنامه در رندر (جهت پینگ خودکار هر ۵ دقیقه برای جلوگیری از به خواب رفتن رندر)
# مثلاً: https://hashemi-consulting-bot.onrender.com
RENDER_EXTERNAL_URL=
